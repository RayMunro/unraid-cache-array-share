<?xml version="1.0" standalone="yes"?>

<!DOCTYPE PLUGIN [
<!ENTITY name "cache-array-share">
<!ENTITY author "Ray Munro">
<!ENTITY version "2026.09.02a">
<!ENTITY package "&name;-&version;-noarch-1.txz">
<!ENTITY github "RayMunro/unraid-cache-array-share">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/&name;.plg">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="Settings/&name;" min="6.12.0"
        pluginURL="&pluginURL;"
        support="https://github.com/&github;/issues"
        project="https://github.com/&github;"
        readme="https://github.com/&github;#readme">

<CHANGES>
<![CDATA[
### 2026.09.02a
- Fix Apply and Restore requests being stopped by duplicate CSRF validation.
- Rely on Unraid's built-in PHP request validation, which validates and then
  removes the token before plugin code runs.

### 2026.09.02
- Initial release.
- Select individual user shares and set a chosen pool as Primary storage.
- Set Array as Secondary storage with Pool -> Array mover direction.
- Preview-first UI with nothing selected by default.
- Preserve unrelated share settings.
- Timestamped backups, verified changes, rollback and one-click restore.
- Mark service-sensitive shares and never start Mover automatically.
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/&name;/&package;" Type="base64" Run="upgradepkg --install-new">
<INLINE>

</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
PLUGIN_BOOT="/boot/config/plugins/cache-array-share"
PLUGIN_WEB="/usr/local/emhttp/plugins/cache-array-share"

mkdir -p "$PLUGIN_BOOT/backups"
chmod 0700 "$PLUGIN_BOOT/backups"
chmod 0755 "$PLUGIN_WEB/scripts/cache-array-share.php"

echo ""
echo "-----------------------------------------------------------"
echo " Cache -> Array Share Control has been installed."
echo " Open Settings -> User Utilities -> Cache -> Array Share Control."
echo " Version: 2026.09.02a"
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
PLUGIN_BOOT="/boot/config/plugins/cache-array-share"

removepkg cache-array-share 2>/dev/null || true
find "$PLUGIN_BOOT" -maxdepth 1 -type f -name 'cache-array-share-*.txz' -delete

echo ""
echo "-----------------------------------------------------------"
echo " Cache -> Array Share Control has been removed."
echo " Backups remain in $PLUGIN_BOOT/backups."
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
